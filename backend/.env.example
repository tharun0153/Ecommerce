# Copy this to .env and fill in your values. Never commit .env to git.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/warpline?retryWrites=true&w=majority

# A long random secret for JWT (use: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-here

# Your Vercel frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-project.vercel.app

# Port (Render sets this automatically)
PORT=5000
